# ============================================================================
# Discovery Pipeline — Environment Variables
# Copy this to .env and fill in your values
# IMPORTANT: no spaces around = signs, no quotes around values
# ============================================================================

# --- Claude (outreach generation + contact web search) ---
# Get from: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# --- Resend (email delivery) ---
# Get from: resend.com -> API Keys
RESEND_API_KEY=

# Sender address. Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=outreach@example.com

# The single inbox every outreach email is redirected to. PUT YOUR OWN ADDRESS HERE.
# If this is empty AND no address is set in the UI field, NOTHING is sent — emails
# are never delivered to the real discovered contacts. The UI field overrides this
# per run.
RESEND_TEST_EMAIL=yourgmail@gmail.com

# --- GitHub (optional) ---
# Raises the API rate limit from 60 to 5000 req/hr. The pipeline runs without it.
# Get from: github.com -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=ghp_xxxxxxxx
